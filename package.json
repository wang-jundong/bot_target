{
  "name": "solana-trading-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "test:grpc": "tsx src/grpc/smokeTest.ts",
    "close-accounts": "tsx src/cli/closeTokenAccounts.ts",
    "sell-all": "tsx src/cli/sellAllTokens.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:prod": "npm run build && (pm2 delete solana-bot || true) && pm2 start ecosystem.config.cjs --env production",
    "stop": "pm2 stop solana-bot",
    "logs": "pm2 logs solana-bot --lines 1000",
    "logs:file": "mkdir -p logs && touch logs/bot-output.txt logs/bot-error.txt && tail -n 1000 -F logs/bot-output.txt logs/bot-error.txt",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:logic": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^1.36.0",
    "@solana/web3.js": "^1.98.2",
    "@triton-one/yellowstone-grpc": "^9.0.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.5.0",
    "pino": "^9.7.0",
    "undici": "^7.10.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.15.21",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
