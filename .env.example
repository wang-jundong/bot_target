# Live is the only supported execution mode.
# Strategy, target wallet, size, slippage, and entry limits are in src/config/trade.ts and src/config/strategyV0*.ts.
EXECUTION_MODE=live
BLOCKED_MINTS=
VIBE_GRPC_ENDPOINT=https://elite.grpc.solanavibestation.com
# Access/bearer token supplied by the Vibe Station gRPC provider.
VIBE_GRPC_TOKEN=
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
HELIUS_SENDER_SWQOS_ONLY=true

WALLET_KEY_FILE=
# The same WALLET_KEY_FILE decrypts every encrypted key.
STRATEGY_V_011_PRIVATE_KEY_ENCRYPTED=
STRATEGY_V_022_PRIVATE_KEY_ENCRYPTED=
STRATEGY_V_031_PRIVATE_KEY_ENCRYPTED=

PRIORITY_FEE_LAMPORTS=
HELIUS_TIP_LAMPORTS=5000
COMPUTE_UNIT_LIMIT=
EVENT_RETENTION_SEC=180
BLOCKHASH_REFRESH_MS=10000
LOG_LEVEL=info
RECOVERY_PATH=./recovery/lifecycle.jsonl
PNL_PATH=./logs/pnl.jsonl
# Closed-trade SOL amounts are wallet balance deltas from the confirmed buy/sell txs (fees + tips included).
